---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import { getLang } from '../i18n/utils';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
const lang = getLang(Astro.url);
---

<html lang={lang}>
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));

			// Apparition au défilement : fondu + légère montée, avec un décalage entre frères.
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reduceMotion || !('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('is-visible'));
			} else {
				const seen = new Map<Element, number>();
				items.forEach((el) => {
					const parent = el.parentElement!;
					const index = seen.get(parent) ?? 0;
					seen.set(parent, index + 1);
					el.style.setProperty('--reveal-delay', `${Math.min(index, 6) * 80}ms`);
				});
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
				);
				items.forEach((el) => observer.observe(el));
			}
		</script>
		<style>
			:root {
				--bg-image-subtle-1: radial-gradient(ellipse at 20% 50%, hsla(190, 90%, 50%, 0.12), transparent 60%);
				--bg-image-subtle-2: radial-gradient(ellipse at 80% 50%, hsla(205, 90%, 55%, 0.12), transparent 60%);
				--bg-blend-mode: normal;
				--bg-scale: 1;
				--bg-gradient-size: 100%;
			}

			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background:
					linear-gradient(var(--grid-line) 1px, transparent 1px) top left / 48px 48px,
					linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) top left / 48px 48px,
					radial-gradient(ellipse 80% 40% at 50% 0%, var(--glow), transparent 70%) top center / 100% 900px no-repeat,
					radial-gradient(ellipse 60% 30% at 50% 100%, var(--glow), transparent 70%) bottom center / 100% 600px no-repeat,
					var(--gray-999);
			}
			:root {
				--grid-line: hsla(190, 60%, 35%, 0.07);
				--glow: hsla(190, 90%, 50%, 0.18);
			}
			:root.theme-dark {
				--grid-line: hsla(190, 90%, 60%, 0.05);
				--glow: hsla(190, 90%, 50%, 0.16);
			}
			@media (forced-colors: active) {
				.backgrounds {
					background: none;
				}
			}
		</style>
	</body>
</html>
