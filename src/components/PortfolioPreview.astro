---
import type { CollectionEntry } from 'astro:content';
import { getLang, localePath, workSlug } from '../i18n/utils';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
const lang = getLang(Astro.url);
---

<a class="card" href={localePath(lang, `/work/${workSlug(id)}`)}>
	<span class="title">{data.title}</span>
	<span class="arrow" aria-hidden="true">→</span>
	<span class="frame">
		<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
	</span>
</a>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-6px);
		border-color: var(--accent-dark);
		box-shadow:
			var(--shadow-md),
			0 0 0 1px var(--accent-dark),
			0 12px 32px -8px hsla(190, 90%, 50%, 0.35);
	}

	.title {
		align-self: flex-start;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 0.375rem;
	}

	.arrow {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		z-index: 1;
		width: 2.5rem;
		height: 2.5rem;
		display: grid;
		place-items: center;
		border-radius: 999rem;
		background: var(--gray-999);
		color: var(--accent-dark);
		font-size: 1.25rem;
		line-height: 1;
		transition:
			transform 0.3s ease,
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.card:hover .arrow,
	.card:focus-visible .arrow {
		transform: translateX(6px);
		background: var(--accent-regular);
		color: var(--accent-text-over);
	}

	.frame {
		margin-top: auto;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #0a1016;
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		transition: transform 0.5s ease;
	}

	.card:hover img,
	.card:focus-visible img {
		transform: scale(1.05);
	}

	@media (min-width: 50em) {
		.card {
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card:hover,
		.card:focus-visible,
		.card:hover .arrow,
		.card:hover img {
			transform: none;
		}
	}
</style>
