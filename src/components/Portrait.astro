---
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
	/** `hero` : grand portrait arrondi (accueil) ; `small` : médaillon rond (À propos). */
	variant?: 'hero' | 'small';
}

const { variant = 'hero' } = Astro.props;
const t = useTranslations(getLang(Astro.url));
const isHero = variant === 'hero';
---

<div class:list={['portrait', variant]}>
	<div class="frame">
		<Image
			src={photo}
			alt={t('photo.alt')}
			format="webp"
			quality={80}
			widths={isHero ? [320, 480, 640, 896] : [144, 288]}
			sizes={isHero ? '(min-width: 50em) 40vw, 80vw' : '9rem'}
			loading={isHero ? 'eager' : 'lazy'}
			fetchpriority={isHero ? 'high' : 'auto'}
			decoding="async"
		/>
	</div>
</div>

<style>
	.portrait {
		--halo: 0 0 24px -2px hsla(190, 90%, 50%, 0.35);
		--halo-hover: 0 0 44px 2px hsla(190, 90%, 55%, 0.6);

		justify-self: center;
		animation: portrait-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.hero {
		width: min(80%, 22rem);
	}

	.small {
		width: 9rem;
		flex-shrink: 0;
		animation-delay: 0.15s;
	}

	.frame {
		overflow: hidden;
		border: 1px solid var(--accent-dark);
		box-shadow: var(--halo);
		background: var(--gray-900);
		transition:
			box-shadow 0.4s ease,
			border-color 0.4s ease;
	}

	.hero .frame {
		aspect-ratio: 3 / 4;
		border-radius: 1.5rem;
	}

	.small .frame {
		aspect-ratio: 1;
		border-radius: 50%;
	}

	.frame:hover {
		box-shadow: var(--halo-hover);
		border-color: var(--accent-light);
	}

	img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.6s ease;
	}

	.frame:hover img {
		transform: scale(1.05);
	}

	@media (min-width: 50em) {
		.hero {
			width: 100%;
			max-width: 24rem;
			justify-self: end;
		}

		.hero .frame {
			border-radius: 3rem;
		}

		.small {
			width: 11rem;
		}
	}

	@keyframes portrait-in {
		from {
			opacity: 0;
			transform: translateY(20px) scale(0.96);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portrait {
			animation: none;
		}

		.frame:hover img {
			transform: none;
		}
	}
</style>
